# ─────────────────────────────────────────────
# SatQuery AI — Environment Configuration
# Copy to .env and fill in your values
# ─────────────────────────────────────────────

# ── Server ─────────────────────────────────────
ENVIRONMENT=development
SECRET_KEY=change-me-in-production

# ── Backend ────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ── Frontend ───────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Storage ────────────────────────────────────
UPLOAD_DIR=./uploads
MODEL_CACHE_DIR=./model_cache
MAX_IMAGE_SIZE_MB=50

# ── Device ─────────────────────────────────────
# Options: "auto", "cuda", "cpu"
DEVICE=auto

# ── Model Names (HuggingFace hub IDs) ──────────
VQA_MODEL_NAME=Salesforce/blip2-opt-2.7b
CAPTIONING_MODEL_NAME=Salesforce/blip2-opt-2.7b
CLIP_MODEL_NAME=ViT-B-32
CHANGE_MODEL_NAME=microsoft/resnet-50
GROUNDING_MODEL_NAME=google/owlvit-base-patch32

# ── CORS ───────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── HuggingFace (optional, for private models) ─
HUGGINGFACE_TOKEN=

# ── Logging ────────────────────────────────────
LOG_LEVEL=INFO
