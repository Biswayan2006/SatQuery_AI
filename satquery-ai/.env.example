# ─────────────────────────────────────────────
# SatQuery AI — Environment Configuration
# Copy to .env and fill in your values
# ─────────────────────────────────────────────

# ── Server ─────────────────────────────────────
ENVIRONMENT=production
SECRET_KEY=replace-with-a-long-random-value

# ── Backend ────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ── Frontend ───────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Storage ────────────────────────────────────
UPLOAD_DIR=/app/data/uploads
REPORTS_DIR=/app/data/reports
TEMP_DIR=/app/data/temp
MODEL_CACHE_DIR=/app/data/cache
MAX_IMAGE_SIZE_MB=50
UPLOAD_TTL_HOURS=24
REPORT_TTL_HOURS=24
TEMP_TTL_HOURS=1

# ── Device ─────────────────────────────────────
# Options: "auto", "cuda", "cpu"
DEVICE=auto

# ── Model Names (HuggingFace hub IDs) ──────────
VQA_MODEL_NAME=Salesforce/blip2-opt-2.7b
CAPTIONING_MODEL_NAME=Salesforce/blip-image-captioning-base
CLIP_MODEL_NAME=ViT-B-32
CHANGE_MODEL_NAME=microsoft/resnet-50
GROUNDING_MODEL_NAME=google/owlvit-base-patch32

# ── CORS ───────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_MAX_AGE=600
TRUSTED_HOSTS=localhost,127.0.0.1

# Authentication. Use JSON arrays for pydantic-settings list fields.
API_KEY_ENABLED=true
API_KEYS=["replace-with-client-key"]
ADMIN_API_KEYS=["replace-with-admin-key"]
ALLOW_MOCK_MODE=false
RATE_LIMIT_PER_MINUTE=60
MAX_CONCURRENT_INFERENCE=1

# ── HuggingFace (optional, for private models) ─
HUGGINGFACE_TOKEN=

# ── Logging ────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
DOCS_ENABLED=true
REDOC_ENABLED=true
